{
  "name": "thermalfs-donghe",
  "version": "1.0.12",
  "description": "ThermalFS Donghe Electron desktop runtime and Nuxt application.",
  "author": "YST",
  "type": "module",
  "private": true,
  "main": "apps/electron/main.cjs",
  "scripts": {
    "build": "npm run build:web",
    "build:icons": "node scripts/generate-icons.cjs",
    "build:web": "node scripts/run-nuxt.cjs build",
    "build:desktop": "node scripts/build-desktop.cjs",
    "dev": "npm run dev:web",
    "dev:web": "node scripts/dev-web.cjs",
    "dev:electron": "node scripts/start-electron.cjs",
    "electron:dev": "node scripts/electron-dev.cjs",
    "generate": "node scripts/run-nuxt.cjs generate",
    "pack:win": "node scripts/pack-win.cjs",
    "preview": "node scripts/run-nuxt.cjs preview",
    "test": "node --test test/*.test.cjs",
    "postinstall": "node scripts/run-nuxt.cjs prepare"
  },
  "build": {
    "appId": "com.yst.thermalfs.donghe",
    "productName": "ThermalFS",
    "directories": {
      "output": "pack"
    },
    "files": [
      "apps/electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".desktop/runtime",
        "to": "runtime"
      },
      {
        "from": ".desktop/server",
        "to": "server"
      }
    ],
    "asar": false,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "win": {
      "icon": "apps/electron/assets/icon.ico",
      "target": [
        "portable",
        "nsis"
      ],
      "signExecutable": false
    },
    "portable": {
      "artifactName": "ThermalFS.${ext}",
      "useZip": true
    },
    "nsis": {
      "artifactName": "ThermalFS Setup ${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "include": "build/installer.nsh",
      "installerLanguages": [
        "zh_TW"
      ]
    }
  },
  "dependencies": {
    "@he-tree/vue": "^2.10.0-beta.2",
    "@mdi/font": "^7.4.47",
    "@msgpack/msgpack": "^3.1.3",
    "@nuxt/image": "^1.11.0",
    "@nuxtjs/leaflet": "^1.3.2",
    "echarts": "^6.0.0",
    "fs": "^0.0.1-security",
    "json-web-token": "^3.2.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "nuxt": "^4.1.1",
    "nuxt-echarts": "^1.0.0",
    "nuxt-jwt-auth": "^1.0.0",
    "nuxt-proxy-request": "^3.0.0",
    "nuxt3-leaflet": "^1.0.13",
    "path": "^0.12.7",
    "pixi.js": "^8.13.2",
    "sass": "^1.92.1",
    "swiper": "^12.0.3",
    "video.js": "^8.23.4",
    "vue": "^3.5.21",
    "vue-draggable-nested-tree": "^2.3.0-beta.1",
    "vue-draggable-next": "^2.2.1",
    "vue-router": "^4.5.1",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "electron": "^22.3.27",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.32.6",
    "vite-plugin-vuetify": "^2.1.2",
    "vuetify": "^3.10.0"
  }
}
